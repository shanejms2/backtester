# Copy to .env and fill locally. Never commit .env.

ALPHAVANTAGE_API_KEY=

# IANA display zone for CLI when --tz is omitted. Never guessed from the machine.
BACKTESTER_TZ=UTC

# Local raw vendor cache (bhavcopy, etc). Not the bar store.
BACKTESTER_DATA_DIR=data

# Keep dense 1m bars this many days; older 1m may be pruned after a native 1h/1d series exists.
BACKTESTER_HOT_1M_DAYS=30

# Set to 1 only if the Alpha Vantage key is premium (outputsize=full daily, CRYPTO_INTRADAY).
BACKTESTER_AV_PREMIUM=0

# Self-hosted ClickHouse (BarStore). Localhost only via docker compose.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=backtester

# Postgres for future user data. Localhost only.
POSTGRES_USER=backtester
POSTGRES_PASSWORD=

# Observability Grafana (observability/ compose). Localhost + https://backtester-logs.shanejames.dev
GRAFANA_PASSWORD=

# Public JSON API (compose service `api` → nginx https://backtester-api.shanejames.dev)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKTESTER_API_KEY=
BACKTESTER_API_HOST=127.0.0.1
BACKTESTER_API_PORT=8088
BACKTESTER_API_MAX_BARS=10000
# Optional comma-separated browser origins; empty = no CORS middleware
BACKTESTER_CORS_ORIGINS=
