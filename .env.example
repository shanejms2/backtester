# Copy to .env and fill locally. Never commit .env.

ALPHAVANTAGE_API_KEY=

# IANA display zone for CLI when --tz is omitted. Never guessed from the machine.
BACKTESTER_TZ=UTC

# Hive Parquet + DuckDB root (gitignored).
BACKTESTER_DATA_DIR=data

# Keep dense 1m bars this many days; older 1m may be pruned after a native 1h/1d series exists.
BACKTESTER_HOT_1M_DAYS=30

# Set to 1 only if the Alpha Vantage key is premium (outputsize=full daily, CRYPTO_INTRADAY).
BACKTESTER_AV_PREMIUM=0
